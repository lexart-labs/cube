# Cube v2 — configuración
#
# Copia este fichero a .env y rellena TODOS los valores.
# No hay valores por defecto para los secretos: si falta uno, o es débil, ni la
# aplicación ni docker compose arrancan (ver Security.md, HIGH-05).
#
# Genera cada secreto con:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# Secretos de la aplicación
# ---------------------------------------------------------------------------

# Firma de la sesión. Mínimo 32 caracteres.
NUXT_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Con docker compose, NUXT_DB_HOST lo fija el propio compose a `db` y este valor
# se ignora. Solo importa si ejecutas la aplicación directamente con `npm run dev`.
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306

NUXT_DB_USER=cube
NUXT_DB_PASSWORD=
NUXT_DB_NAME=lexart_cube

# Pon true en producción: exige TLS contra el servidor MySQL (MED-08).
NUXT_DB_SSL=false

# Contraseña de root de MySQL. Solo la usa el contenedor de base de datos.
# Debe ser distinta de NUXT_DB_PASSWORD: la aplicación nunca se conecta como root.
MYSQL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# Puertos publicados en el host (solo docker compose)
# ---------------------------------------------------------------------------
APP_PORT=3000
# MySQL se publica únicamente en 127.0.0.1, nunca en todas las interfaces.
DB_PORT=3306

# ---------------------------------------------------------------------------
# Varios
# ---------------------------------------------------------------------------
# URL pública de la aplicación. Fija el origen permitido en CORS.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Nivel de log: fatal | error | warn | info | debug | trace
NUXT_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Proxies inversos de confianza — API externa
# ---------------------------------------------------------------------------
# IPs o CIDR separados por comas. VACÍO por defecto, y vacío significa ignorar
# por completo la cabecera `X-Forwarded-For`.
#
# Solo importa si Cube está detrás de un proxy (nginx, un balanceador, Cloudflare):
# sin declararlo, la API externa verá la IP del proxy en vez de la de quien llama
# y las listas blancas de IP no funcionarán como esperas.
#
# ⚠️ No pongas aquí nada que no sea tu propio proxy. `X-Forwarded-For` la escribe
# el cliente: confiar en un origen equivocado permite saltarse la lista de IPs
# mandando la cabecera a mano.
#
# Ejemplo detrás de nginx en la misma máquina:  NUXT_TRUSTED_PROXIES=127.0.0.1,::1
NUXT_TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Datos de ejemplo al arrancar
# ---------------------------------------------------------------------------
# El esquema se crea SIEMPRE al arrancar si faltan tablas: es idempotente y
# seguro, y hace que un despliegue contra una base vacía funcione sin comandos.
#
# Esta bandera es otra cosa: crea cuentas de ejemplo con contraseña CONOCIDA
# (admin@cube.test / cube-demo-2026!), y solo si la base no tiene ni un usuario.
#
# ⚠️ NUNCA la actives en un entorno real: sería regalar una cuenta de
# administrador cuya contraseña está escrita en este repositorio.
NUXT_SEED_ON_STARTUP=false

# ---------------------------------------------------------------------------
# IA generativa — redacción de las evaluaciones IDEAL LEXART
# ---------------------------------------------------------------------------
# OPCIONAL. Sin clave, la aplicación arranca igual y el resto de Cube funciona;
# solo la generación de la redacción queda deshabilitada, con aviso en pantalla.
#
# Clave de Google AI Studio (https://aistudio.google.com/apikey).
# Lo que se envía a Google: rol, notas por bloque, promedio y observaciones.
# El NOMBRE de la persona evaluada no se envía nunca (ver server/utils/gemini.ts).
NUXT_GEMINI_API_KEY=

# Id del modelo. Vacío = el valor por defecto del código (`DEFAULT_MODEL`).
# Google retira modelos cada pocos meses: esta variable existe para poder
# cambiarlo sin tocar código ni reconstruir la imagen.
NUXT_GEMINI_MODEL=
